# Truckkoo — environment template. SECURITY.md §9.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Key names and dummy values only in this file.
#
# EVERYTHING PREFIXED `EXPO_PUBLIC_` IS INLINED INTO THE APP BUNDLE AND IS
# PUBLIC FOREVER. Only these two values are permitted that prefix.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The ANON / publishable key. Public by design — it grants nothing on its own
# because every table denies by default and RLS scopes rows to auth.uid().
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# NEVER PUT THESE HERE OR IN ANY EXPO_PUBLIC_ VARIABLE:
#
#   SUPABASE_SERVICE_ROLE_KEY   bypasses ALL row-level security
#   any SMS / WhatsApp API credential
#   any maps or routing API key with billing attached
#
# Server-side secrets live in the Supabase Edge Function secret store:
#   supabase secrets set SERVICE_THING=...
# They are never read from this file and never reach the client bundle.
# ─────────────────────────────────────────────────────────────────────────────
