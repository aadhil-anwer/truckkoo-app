{
  "expo": {
    "name": "Truckkoo",
    "slug": "truckkoo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "truckkoo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "primaryColor": "#f1551f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.truckkoo.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Truckkoo uses the camera so you can photograph proof of delivery when a load is dropped off.",
        "NSPhotoLibraryUsageDescription": "Truckkoo needs access to your photos so you can attach proof of delivery to a trip."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.truckkoo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Truckkoo needs access to your photos so you can attach proof of delivery to a trip.",
          "cameraPermission": "Truckkoo uses the camera so you can photograph proof of delivery when a load is dropped off."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Truckkoo uses your location to send you loads near your truck, and to show the shipper where their cargo is during a delivery.",
          "locationAlwaysAndWhenInUsePermission": "While you are available, Truckkoo uses your location in the background to send you loads near your truck, and during a delivery to show the shipper where their cargo is. Only your latest location is kept.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/with-first-launch-direction",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "truckkoo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "_comment": "No secrets here. app.json ships inside the bundle — see SECURITY.md §9.",
      "router": {},
      "eas": {
        "projectId": "f3a98e44-b748-4e57-a722-43aad8dfd2e6"
      }
    },
    "owner": "aanwarsadaths-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f3a98e44-b748-4e57-a722-43aad8dfd2e6"
    }
  }
}
